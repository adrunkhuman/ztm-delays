# Scoped to the Airflow Dockerfile; other service build contexts are unaffected.
# Include files, not directories: directory exceptions also include their contents.
**
!airflow/dags/*.py
!airflow/dags/route_map_sql/*.sql
!airflow/dags/route_map_assets/*.svg
!dbt/dbt_project.yml
!dbt/profiles.yml
!dbt/models/**/*.sql
!dbt/models/**/*.yml
!dbt/macros/**/*.sql
!dbt/tests/**/*.sql
!matcher/pyproject.toml
!matcher/uv.lock
!matcher/README.md
!matcher/src/**/*.py
!planner/pyproject.toml
!planner/uv.lock
!planner/README.md
!planner/src/**/*.py
# Defense in depth within allowed source trees.
**/.env*
**/*key*.json
**/credentials*
**/__pycache__/
**/.venv/
**/.git/
**/.pytest_cache/
**/.ruff_cache/
